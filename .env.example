# Gmail SMTP Notification Configuration
SENDER_EMAIL=your_email@gmail.com
APP_PASSWORD=your_16_character_app_password
RECEIVER_EMAIL=recipient_email@gmail.com

# Target Person Info
TARGET_NAME=Authorized_User

# Model & Detector Configuration
MODEL_NAME=Facenet
DETECTOR_BACKEND=retinaface
DISTANCE_THRESHOLD=0.85

# Performance & Security Timing
CHECK_EVERY_N_FRAMES=10
COOLDOWN_SECONDS=300

# Camera Source: 0 for default webcam, or RTSP / DroidCam URL (e.g. http://192.168.1.100:4747/video)
CAMERA_SOURCE=0
